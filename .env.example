# Valfritt: eget Supabase-projekt (Project Settings → API). Standard finns i src/lib/supabase/config.ts. Den publika nyckeln får finnas i webbläsaren – RLS skyddar datan.
NEXT_PUBLIC_APP_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_APP_SUPABASE_ANON_KEY=sb_publishable_xxx

# Valfritt: AI-förslag (fas 6). Endast på servern – aldrig NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Valfritt: kräv e-postinloggning (team, roller, inbjudningar). Utan den får varje enhet ett eget anonymt konto.
# NEXT_PUBLIC_REQUIRE_LOGIN=1

# Valfritt: kör appen helt lokalt utan inloggning och synk (används av e2e-testet).
# NEXT_PUBLIC_LOCAL_ONLY=1
